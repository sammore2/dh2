<form class="cs-sheet dh-character-sheet" autocomplete="off">

  {{!-- Tab dock: lib/side-tabs.mjs moves it out of the window and keeps it on the window's right edge --}}
  <nav class="cs-side-tabs">
    <button type="button" class="dh-tab-btn" data-tab="combat" title="{{localize 'DH.Tabs.Combat'}}"><i class="fa-solid fa-shield-halved"></i></button>
    <button type="button" class="dh-tab-btn" data-tab="loadout" title="{{localize 'DH.Tabs.Loadout'}}"><i class="fa-solid fa-layer-group"></i></button>
    <button type="button" class="dh-tab-btn" data-tab="features" title="{{localize 'DH.Tabs.Features'}}"><i class="fa-solid fa-star"></i></button>
    <button type="button" class="dh-tab-btn" data-tab="inventory" title="{{localize 'DH.Tabs.Inventory'}}"><i class="fa-solid fa-sack-dollar"></i></button>
    <button type="button" class="dh-tab-btn" data-tab="notes" title="{{localize 'DH.Tabs.Notes'}}"><i class="fa-solid fa-book-bookmark"></i></button>
  </nav>

  {{!-- ── Header: portrait, name and class line, level shield ───────────────── --}}
  <header class="rs-top">
    <div class="rs-portrait">
      <img class="rs-portrait-img{{#unless document.avatarUrl}} is-default{{/unless}}" src="{{portrait}}" alt="{{document.name}}" data-portrait-edit title="Clique para trocar a arte" />
    </div>

    <div class="rs-id">
      <input class="rs-name" name="name" type="text" value="{{document.name}}" placeholder="{{localize 'DH.Header.Name'}}" />
      <div class="rs-id-line">
        <span>{{#if classItem}}{{classItem.name}}{{else if system.class}}{{system.class}}{{else}}Sem classe{{/if}}</span>
        <span>{{#if subclassItem}}{{subclassItem.name}}{{else if system.subclass}}{{system.subclass}}{{else}}Sem subclasse{{/if}}</span>
        <span>{{#if heritageText}}{{heritageText}}{{else if system.heritage}}{{system.heritage}}{{else}}Sem herança{{/if}}</span>
        <input name="systemData.pronouns" type="text" value="{{system.pronouns}}" placeholder="Pronomes" />
      </div>
    </div>

    <div class="rs-badge rs-level-badge">
      <div class="rs-shield rs-level">
        <input name="systemData.level" type="number" value="{{system.level}}" min="1" max="10" />
      </div>
      <span class="rs-ribbon">{{localize 'DH.Header.Level'}}</span>
      <button type="button" class="cs-btn" data-action="levelUp" title="Subir de Nível" style="font-size: 10px; padding: 2px 6px; margin-top: 2px;">Subir de Nível</button>
      {{#if hasLegacyData}}
        <button type="button" class="cs-btn warning" data-action="migrateLegacy" title="Migrar dados legados para itens" style="font-size: 10px; padding: 2px 6px; margin-top: 2px;">Migrar ficha antiga</button>
      {{/if}}
    </div>
  </header>

  {{!-- ── PAINEL FIXO SUPERIOR (HP à esquerda, Evasão/Armadura no centro, Esperança/Estresse à direita, Atributos) ── --}}
  <div class="rs-fixed-top">
    {{!-- Linha de Defesas e Vitals --}}
    <div class="rs-vitals-defense-row">
      {{!-- Esquerda: Pontos de Vida (clean, sem fundo pesado) --}}
      <div class="rs-vital-clean hp">
        <div class="rs-vital-clean-head">
          <span>{{localize 'DH.Resources.HP'}}</span>
          <b>{{system.hp.value}} / {{hpMax}}</b>
        </div>
        <div class="dh-dots-row" data-resource="hp">
          {{#numLoop hpMax start=0}}
            <span class="dh-dot hp {{#if (lt this ../system.hp.value)}}marked{{/if}}" data-index="{{this}}" title="Marcar/Desmarcar HP"></span>
          {{/numLoop}}
        </div>
      </div>

      {{!-- Centro: Evasão e Armadura --}}
      <div class="rs-defense-center">
        <div class="rs-badge">
          <div class="rs-shield"><b>{{derived.evasion}}</b></div>
          <span class="rs-ribbon">{{localize 'DH.Resources.Evasion'}}</span>
        </div>
        <div class="rs-badge">
          <div class="rs-shield"><b>{{derived.armorScore}}</b></div>
          <span class="rs-ribbon">{{localize 'DH.Resources.ArmorScore'}}</span>
        </div>
        {{#if armor}}
          <div class="rs-armor-slots">
            <span class="rs-pill">{{localize 'DH.Resources.ArmorSlots'}}</span>
            <div class="dh-armor-pips-grid" data-resource="armorSlots">
              {{#numLoop derived.armorScore start=0}}
                <span class="dh-armor-pip {{#if (lt this ../armor.data.slotsMarked)}}marked{{/if}}" data-index="{{this}}" title="Slot de Armadura"></span>
              {{/numLoop}}
            </div>
          </div>
        {{/if}}
      </div>

      {{!-- Direita: Esperança em cima, Estresse embaixo (clean, sem fundo pesado) --}}
      <div class="rs-vital-clean-col right">
        <div class="rs-vital-clean hope">
          <div class="rs-vital-clean-head">
            <span>{{localize 'DH.Resources.Hope'}}</span>
            <b>{{system.hope.value}} / {{hopeMax}}</b>
          </div>
          <div class="dh-dots-row" data-resource="hope">
            {{#numLoop hopeMax start=0}}
              <span class="dh-dot hope {{#if (lt this ../system.hope.value)}}marked{{/if}}" data-index="{{this}}" title="Slot de Esperança"></span>
            {{/numLoop}}
          </div>
        </div>

        <div class="rs-vital-clean stress">
          <div class="rs-vital-clean-head">
            <span>{{localize 'DH.Resources.Stress'}}</span>
            <b>{{system.stress.value}} / {{stressMax}}</b>
          </div>
          <div class="dh-dots-row" data-resource="stress">
            {{#numLoop stressMax start=0}}
              <span class="dh-dot stress {{#if (lt this ../system.stress.value)}}marked{{/if}}" data-index="{{this}}" title="Marcar/Desmarcar Estresse"></span>
            {{/numLoop}}
          </div>
        </div>
      </div>
    </div>

    {{!-- Limiares de Dano --}}
    <div class="rs-thresholds">
      <span class="rs-th"><b>{{localize 'DH.Thresholds.Minor'}}</b><small>Marca 1 HP</small></span>
      <span class="rs-th-num">{{derived.thresholdMajor}}</span>
      <span class="rs-th"><b>{{localize 'DH.Thresholds.Major'}}</b><small>Marca 2 HP</small></span>
      <span class="rs-th-num">{{derived.thresholdSevere}}</span>
      <span class="rs-th"><b>{{localize 'DH.Thresholds.Severe'}}</b><small>Marca 3 HP</small></span>
    </div>

    {{!-- 6 Atributos Centrais --}}
    <section class="rs-traits">
      {{#each traits as |trait key|}}
        <div class="rs-trait">
          <span class="rs-ribbon">{{localize trait.label}}</span>
          <button type="button" class="dh-trait-score-btn rs-shield" data-trait="{{key}}" title="Rolar {{localize trait.label}} (2d12 Dualidade)">{{numberFormat trait.value sign=true}}</button>
          <span class="rs-trait-sub">{{localize trait.subLabel}}</span>
          <input class="rs-trait-edit" name="systemData.attributes.{{key}}" type="number" value="{{trait.value}}" title="Valor do atributo" />
        </div>
      {{/each}}
    </section>
  </div>

  {{!-- ── ÁREA ROLÁVEL COM ABAS QUE TRANSITAM ───────────────────────────── --}}
  <div class="rs-scroll">
      <div class="cs-tabs">
        <div class="cs-pane-area">
          {{!-- COMBAT --}}
          <section class="tab dh-tab-pane active" data-group="primary" data-tab="combat">
            <div class="cs-prof">
              <span>{{localize 'DH.Resources.Proficiency'}}</span>
              <b>{{system.proficiency}}</b>
            </div>

            <div class="cs-panels">
              <div class="cs-panel">
                <h3>{{localize 'DH.Combat.ActiveWeapons'}}</h3>
                {{#each weaponRows as |row|}}
                  <div class="cs-weapon">
                    {{#if row.w}}
                      <div class="cs-weapon-head">
                        <span class="cs-weapon-name">{{row.w.name}}</span>
                        <button type="button" class="cs-btn" data-action="rollWeaponAttack" data-slot="{{row.slot}}" title="Rolar Ataque"><i class="fa-solid fa-dice-d20"></i></button>
                        <button type="button" class="cs-btn danger" data-action="rollWeaponDamage" data-slot="{{row.slot}}" title="Rolar Dano"><i class="fa-solid fa-bolt"></i></button>
                      </div>
                      <div class="cs-row">
                        <span>{{row.w.data.trait}} · {{row.w.data.range}}</span>
                        <span>{{row.damage}} {{row.w.data.damageType}}</span>
                        <span>{{#if (eq row.w.data.burden 'two')}}Duas mãos{{else}}Uma mão{{/if}}</span>
                      </div>
                      {{#if row.w.data.feature.name}}<div class="cs-hint"><b>{{row.w.data.feature.name}}:</b> {{row.w.data.feature.text}}</div>{{/if}}
                    {{else}}
                      <div class="cs-empty">Arraste uma arma aqui</div>
                    {{/if}}
                  </div>
                {{/each}}
              </div>

              <div class="cs-panel">
                <h3>{{localize 'DH.Combat.ActiveArmor'}}</h3>
                {{#if armor}}
                  <div class="cs-weapon-head"><span class="cs-weapon-name">{{armor.name}}</span></div>
                  <div class="cs-row">
                    <span>Limiares base {{armor.data.baseMajor}} / {{armor.data.baseSevere}}</span>
                    <span>Armor Score {{derived.armorScore}}</span>
                    <span>Marcados {{armor.data.slotsMarked}}</span>
                  </div>
                  {{#if armor.data.feature.name}}<div class="cs-hint"><b>{{armor.data.feature.name}}:</b> {{armor.data.feature.text}}</div>{{/if}}
                {{else}}
                  <div class="cs-empty">Sem armadura</div>
                {{/if}}
              </div>
            </div>
          </section>

          {{!-- LOADOUT --}}
          <section class="tab dh-tab-pane" data-group="primary" data-tab="loadout">
            <div class="cs-toolbar">
              <h3>Loadout Ativo <span class="cs-count {{#if (eq activeLoadoutCount 5)}}full{{/if}}">{{activeLoadoutCount}}/5</span></h3>
              <button type="button" class="cs-btn {{#if restMode}}active{{/if}}" data-act="rest" title="Em descanso, mover cartas não custa Estresse">Modo descanso</button>
            </div>

            <div class="cs-cards">
              {{#each loadout as |card|}}
                <div class="cs-card" data-card-id="{{card.id}}">
                  <div class="cs-card-head">
                    <span class="cs-card-domain">{{card.domain}} · Nv.{{card.level}} · {{card.type}}</span>
                    <span class="cs-card-cost">Recall {{card.recallCost}}</span>
                  </div>
                  <div class="cs-card-name">{{card.name}}</div>
                  <div class="cs-card-desc">{{card.description}}</div>
                  <div class="cs-card-actions">
                    {{#if (eq card.type 'spell')}}<button type="button" class="cs-btn" data-act="cast" data-id="{{card.id}}">Conjurar</button>{{/if}}
                    <button type="button" class="cs-btn" data-action="activateDomainCard" data-card-id="{{card.id}}" title="Anunciar no chat">Ativar</button>
                    <button type="button" class="cs-btn" data-act="toVault" data-id="{{card.id}}" title="Guardar no Vault">Vault</button>
                    <button type="button" class="cs-btn danger" data-action="deleteDomainCard" data-card-id="{{card.id}}" title="Remover"><i class="fa-solid fa-trash"></i></button>
                  </div>
                </div>
              {{else}}
                <div class="cs-empty">Nenhuma carta no Loadout. Arraste cartas do compêndio.</div>
              {{/each}}
            </div>

            <div class="cs-toolbar"><h3>Vault</h3></div>
            <div class="cs-cards">
              {{#each vault as |card|}}
                <div class="cs-card vault" data-card-id="{{card.id}}">
                  <div class="cs-card-head">
                    <span class="cs-card-domain">{{card.domain}} · Nv.{{card.level}} · {{card.type}}</span>
                    <span class="cs-card-cost">Recall {{card.recallCost}}</span>
                  </div>
                  <div class="cs-card-name">{{card.name}}</div>
                  <div class="cs-card-desc">{{card.description}}</div>
                  <div class="cs-card-actions">
                    <button type="button" class="cs-btn" data-act="toLoadout" data-id="{{card.id}}" title="Custa o Recall em Estresse (grátis em descanso)">Mover para o Loadout</button>
                    <button type="button" class="cs-btn danger" data-action="deleteDomainCard" data-card-id="{{card.id}}" title="Remover"><i class="fa-solid fa-trash"></i></button>
                  </div>
                </div>
              {{else}}
                <div class="cs-empty">Nenhuma carta guardada no Vault.</div>
              {{/each}}
            </div>
          </section>

          {{!-- FEATURES --}}
          <section class="tab dh-tab-pane" data-group="primary" data-tab="features">
            {{#if hopeFeature}}
              <div class="cs-panel">
                <h3>{{localize 'DH.Features.HopeFeature'}}</h3>
                <p><b>{{hopeFeature.name}}</b> {{hopeFeature.text}}</p>
                <button type="button" class="cs-btn" data-act="hopeFeature">Usar: {{hopeFeature.cost}} Hope</button>
              </div>
            {{/if}}
            {{#each featureGroups as |g|}}
              <div class="cs-panel">
                <h3>{{g.title}}</h3>
                {{#each g.list as |f|}}<p><b>{{f.name}}</b> {{f.text}}</p>{{/each}}
                {{#if g.swap}}<button type="button" class="cs-btn" data-act="swapAncestry">Trocar</button>{{/if}}
              </div>
            {{else}}
              <div class="cs-empty">Arraste classe, subclasse, ancestralidade e comunidade do compêndio.</div>
            {{/each}}
            <div class="cs-panel">
              <h3>{{localize 'DH.Features.Experiences'}}</h3>
              <p class="cs-hint">Gaste 1 Esperança para somar o bônus da Experiência à rolagem.</p>
              {{#each system.experiences as |exp idx|}}
                <div class="cs-exp" data-index="{{idx}}">
                  <span class="cs-exp-mark">✦</span>
                  <input class="cs-exp-name" name="systemData.experiences.{{idx}}.name" type="text" value="{{exp.name}}" placeholder="ex: Guarda Real Veterano" />
                  <input class="cs-exp-mod" name="systemData.experiences.{{idx}}.modifier" type="number" value="{{exp.modifier}}" title="Modificador" />
                  <button type="button" class="cs-btn" data-action="useExperience" data-index="{{idx}}" title="Gastar 1 Esperança">Usar</button>
                </div>
              {{/each}}
            </div>
          </section>

          {{!-- INVENTORY --}}
          <section class="tab dh-tab-pane" data-group="primary" data-tab="inventory">
            <div class="cs-panel">
              <h3>{{localize 'DH.Gold.Title'}}</h3>
              <div class="cs-gold">
                <div>
                  <span>{{localize 'DH.Gold.Handfuls'}}</span>
                  <div class="dh-dots-row" data-resource="goldHandfuls">
                    {{#numLoop 10 start=0}}<span class="dh-dot coin {{#if (lt this ../system.gold.handfuls)}}marked{{/if}}" data-index="{{this}}"></span>{{/numLoop}}
                  </div>
                </div>
                <div>
                  <span>{{localize 'DH.Gold.Bags'}}</span>
                  <div class="dh-dots-row" data-resource="goldBags">
                    {{#numLoop 10 start=0}}<span class="dh-dot bag {{#if (lt this ../system.gold.bags)}}marked{{/if}}" data-index="{{this}}"></span>{{/numLoop}}
                  </div>
                </div>
                <div>
                  <span>{{localize 'DH.Gold.Chest'}}</span>
                  <div class="dh-dots-row" data-resource="goldChest">
                    {{#numLoop 1 start=0}}<span class="dh-dot chest {{#if (lt this ../system.gold.chest)}}marked{{/if}}" data-index="{{this}}" title="Baú"></span>{{/numLoop}}
                  </div>
                </div>
              </div>
            </div>
            <div class="cs-panel">
              <h3>Armas no inventário</h3>
              {{#each weapons.inventory as |w|}}
                <div class="cs-weapon" draggable="true" data-drag-item-id="{{w.id}}" data-drag-item-name="{{w.name}}">
                  <div class="cs-weapon-head">
                    <span class="cs-weapon-name">{{w.name}}</span>
                    <button type="button" class="cs-btn" data-act="equipWeapon" data-id="{{w.id}}">Equipar</button>
                    <button type="button" class="cs-btn danger" data-act="deleteItem" data-id="{{w.id}}" title="Remover"><i class="fa-solid fa-trash"></i></button>
                  </div>
                </div>
              {{else}}
                <div class="cs-empty">Sem armas no inventário.</div>
              {{/each}}
            </div>
            <div class="cs-panel">
              <h3>Itens</h3>
              {{#each inventoryItems as |it|}}
                <div class="cs-weapon" draggable="true" data-drag-item-id="{{it.id}}" data-drag-item-name="{{it.name}}">
                  <div class="cs-weapon-head">
                    <span class="cs-weapon-name">{{it.name}} &times;{{it.data.quantity}}</span>
                    <button type="button" class="cs-btn" data-act="qty" data-id="{{it.id}}" data-delta="-1">−</button>
                    <button type="button" class="cs-btn" data-act="qty" data-id="{{it.id}}" data-delta="1">+</button>
                    <button type="button" class="cs-btn danger" data-act="deleteItem" data-id="{{it.id}}" title="Remover"><i class="fa-solid fa-trash"></i></button>
                  </div>
                </div>
              {{else}}
                <div class="cs-empty">Sem itens.</div>
              {{/each}}
            </div>
          </section>

          {{!-- NOTES --}}
          <section class="tab dh-tab-pane" data-group="primary" data-tab="notes">
            <div class="cs-panel">
              <h3>Conexões com o Grupo & Perguntas de Campanha</h3>
              <textarea name="systemData.notes" rows="12" placeholder="Laços com os outros personagens, histórias e objetivos...">{{system.notes}}</textarea>
            </div>
          </section>
        </div>
      </div>
  </div>
</form>
