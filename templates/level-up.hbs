<form class="cs-sheet dh-level-up-dialog" autocomplete="off">
  <header class="cs-banner" style="margin-bottom: 12px;">
    <h2>Subir de Nível (Nível {{currentLevel}} → {{nextLevel}})</h2>
    <p class="cs-hint">Escolha 2 opções de avanço para seu personagem (Tier {{targetTier}}):</p>
  </header>

  <div class="cs-body single" style="display: flex; flex-direction: column; gap: 10px;">
    {{#each options as |opt|}}
      <label class="cs-row" style="display: flex; align-items: center; justify-content: space-between; padding: 6px; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px;">
        <span style="flex: 1;">
          <b>{{opt.label}}</b>
          <small style="display: block; opacity: 0.7;">Disponíveis neste tier: {{opt.available}}/{{opt.max}} {{#if opt.cost2}}(Custa 2 avanços){{/if}}</small>
        </span>
        <input type="checkbox" name="advOption" value="{{opt.type}}" data-cost="{{opt.cost}}" {{#if (eq opt.available 0)}}disabled{{/if}} />
      </label>
    {{/each}}

    <label class="cs-row" style="opacity: 0.5; padding: 6px; border: 1px dashed rgba(255,255,255,0.1);">
      <span><b>Multiclasse</b> <small style="display: block;">(Multiclasse ainda não implementada)</small></span>
      <input type="checkbox" disabled />
    </label>

    <div style="margin-top: 14px; display: flex; justify-content: flex-end; gap: 8px;">
      <button type="button" class="cs-btn" data-action="cancel">Cancelar</button>
      <button type="button" class="cs-btn success" data-action="confirm">Confirmar Level Up</button>
    </div>
  </div>
</form>
