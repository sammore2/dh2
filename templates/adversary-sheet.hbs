<form class="cs-sheet dh-adversary-sheet" autocomplete="off">
  {{!-- ── Header: portrait, name, tier & role, difficulty shield ──────────── --}}
  <header class="rs-top">
    <div class="rs-portrait">
      <img class="rs-portrait-img{{#unless document.avatarUrl}} is-default{{/unless}}" src="{{portrait}}" alt="{{document.name}}" data-portrait-edit title="Clique para trocar a arte" />
    </div>

    <div class="rs-id">
      <input class="rs-name" name="name" type="text" value="{{document.name}}" placeholder="{{localize 'DH.ActorType.Adversary'}}" />
      <div class="rs-id-line">
        <div class="rs-id-tag">
          <span>Tier</span>
          <select name="systemData.tier">
            <option value="0" {{#if (eq system.tier 0)}}selected{{/if}}>Tier 0</option>
            <option value="1" {{#if (eq system.tier 1)}}selected{{/if}}>Tier 1</option>
            <option value="2" {{#if (eq system.tier 2)}}selected{{/if}}>Tier 2</option>
            <option value="3" {{#if (eq system.tier 3)}}selected{{/if}}>Tier 3</option>
            <option value="4" {{#if (eq system.tier 4)}}selected{{/if}}>Tier 4</option>
          </select>
        </div>
        <div class="rs-id-tag">
          <span>Papel</span>
          <input name="systemData.role" type="text" value="{{system.role}}" placeholder="Standard, Solo, Horde, Bruiser..." />
        </div>
      </div>
    </div>

    <div class="rs-badge rs-dc-badge">
      <div class="rs-shield rs-dc">
        <input name="systemData.difficulty" type="number" value="{{system.difficulty}}" min="1" max="30" />
      </div>
      <span class="rs-ribbon">{{localize 'DH.Adversary.Difficulty'}} (DC)</span>
    </div>
  </header>

  {{!-- ── PAINEL FIXO SUPERIOR (HP à esquerda, Estresse à direita, Limiares abaixo) ── --}}
  <div class="rs-fixed-top">
    <div class="dh-adv-vitals-row">
      {{!-- Esquerda: Pontos de Vida (HP) --}}
      <div class="rs-vital-clean hp">
        <div class="rs-vital-clean-head">
          <span>{{localize 'DH.Resources.HP'}}</span>
          <b>{{system.hp.value}} / {{system.hp.max}}</b>
          <span class="rs-max-pill">Max: <input class="rs-inline-input" name="systemData.hp.max" type="number" value="{{system.hp.max}}" min="1" /></span>
        </div>
        <div class="dh-dots-row" data-resource="hp">
          {{#numLoop system.hp.max start=0}}
            <span class="dh-dot hp {{#if (lt this ../system.hp.value)}}marked{{/if}}" data-index="{{this}}" title="Marcar/Desmarcar HP"></span>
          {{/numLoop}}
        </div>
      </div>

      {{!-- Direita: Estresse --}}
      <div class="rs-vital-clean stress right">
        <div class="rs-vital-clean-head">
          <span class="rs-max-pill">Max: <input class="rs-inline-input" name="systemData.stress.max" type="number" value="{{system.stress.max}}" min="0" /></span>
          <b>{{system.stress.value}} / {{system.stress.max}}</b>
          <span>{{localize 'DH.Resources.Stress'}}</span>
        </div>
        <div class="dh-dots-row" data-resource="stress">
          {{#numLoop system.stress.max start=0}}
            <span class="dh-dot stress {{#if (lt this ../system.stress.value)}}marked{{/if}}" data-index="{{this}}" title="Marcar/Desmarcar Estresse"></span>
          {{/numLoop}}
        </div>
      </div>
    </div>

    {{!-- Abaixo: Limiares de Dano --}}
    <div class="rs-thresholds">
      <div class="rs-th-card minor">
        <span class="rs-th-title">{{localize 'DH.Thresholds.Minor'}}</span>
        <span class="rs-th-range">&lt; {{system.thresholds.major}}</span>
      </div>
      <div class="rs-th-card major">
        <span class="rs-th-title">{{localize 'DH.Thresholds.Major'}}</span>
        <input class="rs-th-input" name="systemData.thresholds.major" type="number" value="{{system.thresholds.major}}" />
      </div>
      <div class="rs-th-card severe">
        <span class="rs-th-title">{{localize 'DH.Thresholds.Severe'}}</span>
        <input class="rs-th-input" name="systemData.thresholds.severe" type="number" value="{{system.thresholds.severe}}" />
      </div>
    </div>
  </div>

  {{!-- ── ÁREA ROLÁVEL (Ataques, Habilidades de Medo, Motivos) ───────────── --}}
  <div class="rs-scroll">
    {{!-- Ataques --}}
    <div class="cs-panel">
      <div class="cs-panel-head">
        <h3>⚔ {{localize 'DH.Adversary.Attacks'}}</h3>
        <button type="button" class="cs-btn-add" data-action="addAttack" title="Adicionar Ataque"><i class="fa-solid fa-plus"></i></button>
      </div>

      <div class="dh-adv-attacks-list">
        {{#each system.attacks as |attack idx|}}
          <div class="cs-card-item">
            <div class="cs-card-top-row">
              <input class="cs-card-title-input" name="systemData.attacks.{{@index}}.name" type="text" value="{{attack.name}}" placeholder="Nome do Ataque" />

              <select class="cs-card-select" name="systemData.attacks.{{@index}}.range">
                <option value="Melee" {{#if (eq attack.range 'Melee')}}selected{{/if}}>Corpo a Corpo</option>
                <option value="Very Close" {{#if (eq attack.range 'Very Close')}}selected{{/if}}>Muito Perto</option>
                <option value="Close" {{#if (eq attack.range 'Close')}}selected{{/if}}>Perto</option>
                <option value="Far" {{#if (eq attack.range 'Far')}}selected{{/if}}>Longe</option>
                <option value="Very Far" {{#if (eq attack.range 'Very Far')}}selected{{/if}}>Muito Longe</option>
              </select>

              <div class="cs-dmg-input-group">
                <input class="cs-dmg-val" name="systemData.attacks.{{@index}}.damage" type="text" value="{{attack.damage}}" placeholder="1d8+2" />
                <select class="cs-dmg-type" name="systemData.attacks.{{@index}}.damageType">
                  <option value="physical" {{#if (eq attack.damageType 'physical')}}selected{{/if}}>Físico</option>
                  <option value="magic" {{#if (eq attack.damageType 'magic')}}selected{{/if}}>Mágico</option>
                </select>
              </div>

              <div class="cs-card-action-btns">
                <button type="button" class="cs-btn danger" data-action="rollAdversaryDamage" data-index="{{@index}}" title="Rolar Dano do Ataque">
                  <i class="fa-solid fa-bolt"></i> Rolar
                </button>
                <button type="button" class="cs-btn icon danger" data-action="deleteAttack" data-index="{{@index}}" title="Remover"><i class="fa-solid fa-trash"></i></button>
              </div>
            </div>

            <input class="cs-card-desc-input" name="systemData.attacks.{{@index}}.feature" type="text" value="{{attack.feature}}" placeholder="Efeito ou característica adicional do ataque..." />
          </div>
        {{else}}
          <div class="cs-empty">Sem ataques cadastrados. Clique no + acima para adicionar.</div>
        {{/each}}
      </div>
    </div>

    {{!-- Habilidades de Medo --}}
    <div class="cs-panel">
      <div class="cs-panel-head">
        <h3><i class="fa-solid fa-skull"></i> {{localize 'DH.Adversary.FearFeatures'}}</h3>
        <button type="button" class="cs-btn-add" data-action="addFearFeature" title="Adicionar Habilidade de Medo"><i class="fa-solid fa-plus"></i></button>
      </div>

      <div class="dh-adv-features-list">
        {{#each system.fearFeatures as |feat|}}
          <div class="cs-card-item">
            <div class="cs-card-top-row">
              <input class="cs-card-title-input" name="systemData.fearFeatures.{{@index}}.name" type="text" value="{{feat.name}}" placeholder="Nome da Habilidade de Medo" />

              <div class="cs-fear-cost-tag">
                <span>Custo Medo:</span>
                <input name="systemData.fearFeatures.{{@index}}.cost" type="number" value="{{feat.cost}}" min="1" max="12" />
              </div>

              <div class="cs-card-action-btns">
                <button type="button" class="cs-btn" data-action="broadcastFearFeature" data-index="{{@index}}" title="Ativar e Anunciar no Chat">
                  <i class="fa-solid fa-skull"></i> Ativar
                </button>
                <button type="button" class="cs-btn icon danger" data-action="deleteFearFeature" data-index="{{@index}}" title="Remover"><i class="fa-solid fa-trash"></i></button>
              </div>
            </div>

            <textarea name="systemData.fearFeatures.{{@index}}.description" rows="2" placeholder="Descrição do efeito da habilidade de Medo...">{{feat.description}}</textarea>
          </div>
        {{else}}
          <div class="cs-empty">Sem habilidades de Medo. Clique no + acima para adicionar.</div>
        {{/each}}
      </div>
    </div>

    {{!-- Motivos e Táticas --}}
    <div class="cs-panel">
      <h3>📜 {{localize 'DH.Adversary.Motives'}}</h3>
      <textarea name="systemData.motives" rows="3" placeholder="Instintos, táticas de combate e objetivos do adversário...">{{system.motives}}</textarea>
    </div>
  </div>
</form>
